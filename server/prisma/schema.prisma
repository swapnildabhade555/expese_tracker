// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String              @id @default(uuid())
  email                String              @unique
  password             String              // Hashed password
  name                 String
  currency             Currency            @default(INR)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  categories           Category[]
  expensesPaid         Expense[]           @relation("PaidExpenses")
  recurringExpenses    RecurringExpense[]  @relation("PaidRecurringExpenses")
  refreshTokens        RefreshToken[]
  categoryBudgets      CategoryBudget[]
  monthlyBudget        MonthlyBudget?
  splits               ExpenseSplit[]
  memberships          GroupMember[]
  groupsOwned          Group[]             @relation("GroupOwner")
  paidGroupExpenses    GroupExpense[]      @relation("PaidGroupExpenses")
  createdGroupExpenses GroupExpense[]      @relation("CreatedGroupExpenses")
  groupExpenseSplits   GroupExpenseSplit[]
  sentSettlements      GroupSettlement[]   @relation("SentSettlements")
  receivedSettlements  GroupSettlement[]   @relation("ReceivedSettlements")
  groupActivityLogs    GroupActivityLog[]
  groupNotifications   GroupNotification[]
}

model Category {
  id                String             @id @default(uuid())
  name              String
  icon              String             @default("📁") // Emoji or short icon identifier
  isDefault         Boolean            @default(false)
  userId            String?
  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  budgets           CategoryBudget[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([name, userId])
}

model Group {
  id           String             @id @default(uuid())
  name         String
  description  String?
  currency     Currency           @default(INR)
  joinCode     String             @unique
  ownerId      String
  owner        User               @relation("GroupOwner", fields: [ownerId], references: [id])
  status       GroupStatus        @default(ACTIVE)
  members      GroupMember[]
  invitations  GroupInvitation[]
  groupExpenses GroupExpense[]
  settlements  GroupSettlement[]
  activityLogs GroupActivityLog[]
  expenses     Expense[]          // Retained for database compatibility with individual Expense model
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model GroupMember {
  id        String            @id @default(uuid())
  groupId   String
  group     Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      GroupRole         @default(MEMBER)
  status    GroupMemberStatus @default(PENDING)
  joinedAt  DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([groupId, userId])
}

model Expense {
  id                 String            @id @default(uuid())
  description        String
  amount             Decimal           // Stores precise financial values
  currency           Currency          @default(INR)
  date               DateTime          @default(now())
  categoryId         String
  category           Category          @relation(fields: [categoryId], references: [id])
  paidById           String            // The user who paid the bill
  paidBy             User              @relation("PaidExpenses", fields: [paidById], references: [id])
  groupId            String?           // Nullable (null if it is a personal/individual expense)
  group              Group?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  subgroupName       String?           // Specific subgroup tag/name within the group
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation("GeneratedExpenses", fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  splits             ExpenseSplit[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model ExpenseSplit {
  id         String   @id @default(uuid())
  expenseId  String
  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountOwed Decimal  // How much this user owes for this expense
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([expenseId, userId])
}

enum RecurrenceInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model RecurringExpense {
  id          String             @id @default(uuid())
  description String
  amount      Decimal            // Stores precise financial values
  currency    Currency           @default(INR)
  startDate   DateTime           @default(now())
  nextDueDate DateTime           @default(now())
  interval    RecurrenceInterval
  categoryId  String
  category    Category           @relation(fields: [categoryId], references: [id])
  paidById    String             // The user who set it up
  paidBy      User               @relation("PaidRecurringExpenses", fields: [paidById], references: [id])
  isActive    Boolean            @default(true)
  expenses    Expense[]          @relation("GeneratedExpenses")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model CategoryBudget {
  id         String   @id @default(uuid())
  limit      Decimal  // Monthly limit amount
  currency   Currency @default(INR) // Budget currency (locked to home currency)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId]) // One budget per category per user
}

model MonthlyBudget {
  id        String   @id @default(uuid())
  limit     Decimal  // Monthly overall limit amount
  currency  Currency @default(INR) // Budget currency (locked to home currency)
  userId    String   @unique // One overall budget limit per user
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Currency {
  INR
  USD
  EUR
  AUD
}

enum GroupStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum GroupMemberStatus {
  PENDING
  APPROVED
  REJECTED
  LEFT
  REMOVED
}

enum GroupInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum GroupExpenseCategory {
  Food
  Fuel
  Hotel
  Shopping
  Travel
  Entertainment
  Medical
  Miscellaneous
}

enum GroupSplitType {
  EQUAL
  EXACT
  SHARES
  CUSTOM
}

enum SettlementStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model GroupInvitation {
  id           String                @id @default(uuid())
  token        String                @unique
  groupId      String
  group        Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedEmail String?
  expiryTime   DateTime
  status       GroupInvitationStatus @default(PENDING)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model GroupExpense {
  id                String               @id @default(uuid())
  title             String
  description       String?
  amount            Decimal
  currency          Currency             @default(INR)
  category          GroupExpenseCategory
  receiptPath       String?              // Image/PDF storage path
  receiptUploadedBy String?
  receiptUploadedAt DateTime?
  expenseDate       DateTime             @default(now())
  paidById          String
  paidBy            User                 @relation("PaidGroupExpenses", fields: [paidById], references: [id])
  createdById       String
  createdBy         User                 @relation("CreatedGroupExpenses", fields: [createdById], references: [id])
  groupId           String
  group             Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  splitType         GroupSplitType       @default(EQUAL)
  splits            GroupExpenseSplit[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model GroupExpenseSplit {
  id             String       @id @default(uuid())
  groupExpenseId String
  groupExpense   GroupExpense @relation(fields: [groupExpenseId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountOwed     Decimal
  share          Decimal?     // For share split validation
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([groupExpenseId, userId])
}

model GroupSettlement {
  id         String           @id @default(uuid())
  groupId    String
  group      Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payerId    String
  payer      User             @relation("SentSettlements", fields: [payerId], references: [id])
  receiverId String
  receiver   User             @relation("ReceivedSettlements", fields: [receiverId], references: [id])
  amount     Decimal
  status     SettlementStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model GroupActivityLog {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  metadata  Json?
  timestamp DateTime @default(now())
}

model GroupNotification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  metadata  Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
